{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar ProyectoEduca",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",

                "-I",
                "${workspaceFolder}/Include",

                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Usuario.cpp",
                "${workspaceFolder}/src/GestorUsuarios.cpp",
                "${workspaceFolder}/src/GestorTXT.cpp",

                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila todos los archivos fuente de ProyectoEduca con C++17."
        }
    ]
}